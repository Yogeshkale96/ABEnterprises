# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ab_enterprises
DB_USER=root
DB_PASSWORD=your_mysql_password

# Auth — use two DIFFERENT long random secrets in production.
# JWT_SECRET / JWT_EXPIRES_IN are kept for backward compatibility but the
# JWT_ACCESS_* / JWT_REFRESH_* names below take precedence.
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=2h

JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=abenterprises-api
JWT_AUDIENCE=abenterprises-client

# Seeded admin account (used by npm run db:seed)
ADMIN_EMAIL=abenterprises@gmail.com
ADMIN_PASSWORD=abenterprises@123

# Dedicated admin seed (npm run seed:admin) — required, no defaults
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=abenterprises@gmail.com
SEED_ADMIN_PASSWORD=replace_with_strong_password
# Set to 1 to also update the password when the account already exists
# SEED_ADMIN_UPDATE_PASSWORD=1
