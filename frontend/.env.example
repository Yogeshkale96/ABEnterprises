# Base URL of the backend API. In development the Vite proxy forwards /api
# to http://localhost:5000, and production builds fall back to the deployed
# backend — set this only to override (e.g. a custom domain).
# VITE_API_BASE_URL=/api/v1
# VITE_API_BASE_URL=https://abenterprisess.onrender.com/api/v1

# Mobile (Capacitor) builds: relative /api/v1 will NOT work inside the
# native WebView. Set an absolute HTTPS URL before running cap:sync:
# VITE_API_BASE_URL=https://your-domain.com/api/v1
